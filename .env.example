# Public-safe template. Copy to .env and replace every placeholder.
SERVER_URL=https://example.com
ADMIN_USERNAME=replace-me
ADMIN_PASSWORD=replace-with-a-long-random-password
PROMOTION_TRACKING_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-me
OPENAI_MODEL=replace-with-an-approved-model

# Toss Sharelink Open API. Keep disabled until the integration is verified.
TOSS_ACCESS_KEY=replace-me
TOSS_SECRET_KEY=replace-me
TOSS_PUBLISHER_ID=replace-me
TOSS_LIVE_RECOMMENDATIONS=false

BACKEND_POSTGRES_VERSION=13
BACKEND_POSTGRES_USER=replace-me
BACKEND_POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKEND_POSTGRES_DB=replace-me
